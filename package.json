{
  "name": "her-world",
  "version": "0.6.0",
  "type": "module",
  "description": "Her World: a modular DSH-backed companion.",
  "exports": {
    ".": "./dist/src/console/plugin.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./00-Core": "./dist/src/core/plugin.js",
    "./00-Core/locale/*.json": "./locale/core/*.json",
    "./client": "./src/desktop/platform/client.js",
    "./20-Emotion": "./dist/src/emotion/plugin.js",
    "./22-Economy": "./dist/src/living/economy/plugin.js",
    "./25-Behavior": "./dist/src/living/body/plugin.js",
    "./30-Desktop": "./dist/src/desktop/plugin.js",
    "./35-PetPlatform": "./dist/src/desktop/platform/plugin.js",
    "./70-Voice": "./dist/src/voice/plugin.js",
    "./10-Memory": "./dist/src/memory/plugin.js",
    "./40-Life": "./dist/src/living/plan/plugin.js",
    "./50-Room": "./dist/src/room/plugin.js",
    "./60-Channels": "./dist/src/channels/plugin.js",
    "./channel-guest": "./dist/src/channels/guest.js"
  },
  "types": "./dist/src/console/plugin.d.ts",
  "bin": {
    "dafeiyu-setup": "scripts/install-dsh.mjs",
    "dafeiyu-standalone": "src/desktop/standalone.mjs",
    "dafeiyu-backup": "scripts/companion-backup.mjs"
  },
  "imports": {
    "#dsh-world/*": "./vendor/dsh-world/lib/*.js",
    "#feiyu-home": "./vendor/feiyu-room-template/home-state.js",
    "#feiyu-room/*": "./vendor/feiyu-room-template/src/*.js",
    "#feiyu-garden": "./vendor/feiyu-room-template/public/room/garden-state.js"
  },
  "files": [
    "dist/src",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "locale/",
    "src/console/client.js",
    "src/desktop/platform/client.js",
    "src/desktop/standalone.mjs",
    "vendor/dsh-pet/platform/",
    "src/desktop/assets/",
    "src/desktop/helper/",
    "src/room/shot-browser.cjs",
    "src/room/voice-client.js",
    "src/room/identity-client.js",
    "src/room/window*.cjs",
    "src/memory/*.py",
    "vendor/mnemosyne/",
    "vendor/dsh-world/",
    "docs/settings.md",
    "docs/portability.md",
    "scripts/companion-backup.mjs",
    "scripts/install-dsh.mjs",
    "scripts/lib/portable-repo.mjs",
    "scripts/lib/device-runtime.mjs",
    "scripts/lib/offline-backup.mjs",
    "scripts/lib/repo-storage.mjs",
    "scripts/lib/core-config.mjs",
    "vendor/dsh-pet/LICENSE",
    "vendor/dsh-pet/origin.json",
    "vendor/feiyu-room-template/",
    "!dist/src/**/*.js.map",
    "!vendor/dsh-pet/platform/upstream/**",
    "!vendor/dsh-pet/platform/runtime/electron-helper/main/smoke.js",
    "!src/desktop/helper/upstream/index.html",
    "!vendor/feiyu-room-template/public/room/garden-showcase.html",
    "!vendor/mnemosyne/requirements-test.lock",
    "!vendor/mnemosyne/service/README.md",
    "!vendor/mnemosyne/service/pyproject.toml",
    "!vendor/feiyu-room-template/public/room/assets/pet/*.webm",
    "release.json",
    "docs/development.md",
    "docs/github-updates.md"
  ],
  "engines": {
    "node": ">=24.9 <25",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "check:env": "node scripts/doctor.mjs --development",
    "check:types": "tsc --noEmit",
    "build": "node scripts/build/clean-build.mjs && node scripts/build/build-desktop-animation.mjs && node scripts/build/build-animation-map.mjs && node scripts/build/build-pet-platform.mjs && tsc -p tsconfig.build.json",
    "test": "pnpm run build && node --test dist/tests/*/*.test.js tests/world/world-*.test.mjs",
    "test:native-workspace": "pnpm run build && node scripts/checks/check-native-workspace.mjs",
    "test:memory": "pnpm run build && .venv/bin/python tests/memory/memory_provider_test.py && node --test tests/memory/memory-process.test.mjs tests/memory/fact-attribution-contract.test.mjs",
    "test:native-desktop": "pnpm run build && node scripts/checks/check-native-desktop.mjs",
    "test:desktop-window": "node scripts/checks/check-desktop-window.mjs",
    "test:native-portability": "pnpm run build && node scripts/checks/check-native-portability.mjs",
    "test:native-batch": "pnpm run build && CHATPET_CHECK_BATCH=1 node scripts/checks/check-native-desktop.mjs",
    "test:desktop-lifecycle": "node scripts/checks/check-desktop-lifecycle.mjs",
    "test:desktop-images": "pnpm run build && node scripts/checks/check-desktop-images.mjs",
    "test:native-life": "pnpm run build && node scripts/checks/check-native-life.mjs",
    "test:native-room": "pnpm run build && node scripts/checks/check-native-room.mjs --photo",
    "test:native-channel-homes": "pnpm run build && node scripts/checks/check-native-channel-homes.mjs",
    "test:pet-platform-window": "pnpm run build && node scripts/checks/check-pet-platform-window.mjs",
    "test:native-services": "pnpm run build && node scripts/checks/check-native-services.mjs",
    "test:native-context": "pnpm run build && node scripts/checks/check-native-context.mjs",
    "test:native-usage": "pnpm run build && node scripts/checks/check-native-usage.mjs",
    "check:context-payload": "node scripts/checks/check-context-payload.mjs",
    "test:room-voice": "pnpm run build && node scripts/checks/check-room-voice.mjs",
    "test:room-refresh": "pnpm run build && node tests/manual/room-refresh-window.mjs",
    "check:package": "node scripts/checks/check-runtime-package.mjs",
    "check:release": "node scripts/checks/check-release.mjs",
    "check:arch": "node scripts/arch/check.mjs",
    "metrics": "node scripts/arch/metrics.mjs",
    "test:behavior-list": "node --test tests/behavior-list/index.test.mjs && node scripts/checks/run-behavior-list.mjs",
    "verify": "node scripts/checks/verify.mjs",
    "check:published": "node scripts/checks/check-published.mjs"
  },
  "optionalDependencies": {
    "@andresaya/edge-tts": "1.9.1",
    "@electron-internal/extract-zip": "1.0.3",
    "@electron/get": "5.0.0",
    "@snowluma/sdk": "1.14.20",
    "ws": "8.22.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-include": "1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "24.10.0",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyyino7/her-world.git"
  },
  "homepage": "https://github.com/hyyino7/her-world#readme",
  "bugs": {
    "url": "https://github.com/hyyino7/her-world/issues"
  },
  "author": "hyyino7",
  "keywords": [
    "dsh",
    "companion",
    "desktop-pet",
    "dafeiyu"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
